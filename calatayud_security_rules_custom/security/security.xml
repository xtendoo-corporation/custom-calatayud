<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Categoría para el grupo -->
        <record id="module_category_administrador_tarifas" model="ir.module.category">
            <field name="name">Administrador de Tarifas</field>
            <field name="description">Control de acceso para tarifas de venta</field>
            <field name="sequence">100</field>
        </record>

        <!-- Grupo de seguridad -->
        <record id="group_administrador_tarifas" model="res.groups">
            <field name="name">Administrador de Tarifas</field>
            <field name="category_id" ref="module_category_administrador_tarifas"/>
            <field name="comment">Permite asignar tarifas de venta a contactos</field>
        </record>

        <!-- Regla de acceso para administradores de tarifas -->
        <record id="partner_tarifa_admin_rule" model="ir.rule">
            <field name="name">Administradores pueden modificar tarifas de contactos</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_administrador_tarifas'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
