<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Herdar la vista formulario de res.partner -->
        <record id="view_partner_form_inherit_pricelist" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.pricelist</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="product.view_partner_property_form"/>
            <field name="arch" type="xml">
                <!-- Modificar el campo Tarifa existente para añadir restricción de grupo -->
                <xpath expr="//field[@name='property_product_pricelist']" position="attributes">
                    <attribute name="groups">security_rules_custom.group_administrador_tarifas</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
