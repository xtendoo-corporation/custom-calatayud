<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_pricelist" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.pricelist</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="product.view_partner_property_form"/>
            <field name="arch" type="xml">
                <!-- Modificar el campo Tarifa existente para añadir restricción de grupo -->
                <xpath expr="//field[@name='property_product_pricelist']" position="replace">
                   <field name="property_product_pricelist" groups="calatayud_security_rules_custom.group_administrador_tarifas"
                           invisible="not is_company and parent_id"/>
                    <div name="parent_pricelists" groups="product.group_product_pricelist" colspan="2"
                         invisible="is_company or not parent_id">
                        <p>Pricelists are managed on
                            <button name="open_commercial_entity" type="object" string="the parent company"
                                    class="oe_link"/>
                        </p>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
