<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir el campo partner_type a la vista tree de contactos -->
    <record id="view_partner_tree_with_partner_type" model="ir.ui.view">
        <field name="name">res.partner.tree.with.partner.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_type" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Añadir el campo partner_type a la vista formulario de contactos -->
    <record id="view_partner_form_with_partner_type" model="ir.ui.view">
        <field name="name">res.partner.form.with.partner.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="partner_type"/>
            </xpath>
        </field>
    </record>

    <!-- Añadir el campo partner_type a la vista de filtro para permitir búsquedas -->
    <record id="view_res_partner_filter_partner_type" model="ir.ui.view">
        <field name="name">res.partner.select.partner.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="partner_type"/>
                <filter string="Profesional" name="partner_type_profesional" domain="[('partner_type','=','profesional')]"/>
                <filter string="Particular" name="partner_type_particular" domain="[('partner_type','=','particular')]"/>
            </xpath>
            <xpath expr="//filter[@name='group_country']" position="after">
                <filter string="Tipo de Contacto" name="group_partner_type" context="{'group_by': 'partner_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
