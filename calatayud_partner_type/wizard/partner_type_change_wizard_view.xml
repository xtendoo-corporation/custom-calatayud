<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_type_change_wizard_form" model="ir.ui.view">
        <field name="name">res.partner.type.change.wizard.form</field>
        <field name="model">res.partner.type.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar Tipo de Contacto">
                <sheet>
                    <div class="oe_title">
                        <h1>Cambiar Tipo de Contacto</h1>
                    </div>
                    <group>
                        <field name="count_partners" readonly="1"/>
                        <field name="partner_type" widget="radio"/>
                    </group>
                    <field name="partner_ids" options="{'no_create': True}" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_change_partner_type" string="Aplicar cambios" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

