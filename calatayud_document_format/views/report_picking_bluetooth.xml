<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Formato de papel Bluetooth -->
        <record id="bluetooth_delivery_2" model="report.paperformat">
            <field name="name">Bluetooth delivery_2</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_right">1.5</field>
            <field name="margin_left">1.5</field>
            <field name="page_height">300</field>
            <field name="page_width">80</field>
            <field name="orientation">Portrait</field>
            <field name="header_line">False</field>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Template Bluetooth - sin web.html_container para respetar el formato de papel -->
        <template id="report_picking_bluetooth_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
                    <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
                    <t t-set="res_company" t-value="o.company_id"/>

                    <div class="article o_report_layout_standard" style="page-break-after: always;">
                        <main>
                            <div style="font-size: 9px; padding: 5px;">

                                <!-- CABECERA PERSONALIZADA -->
                                <div style="text-align: center; margin-bottom: 10px;">
                                    <!-- Logo -->
                                    <div t-if="res_company.logo" style="margin-bottom: 5px;">
                                        <img t-att-src="image_data_uri(res_company.logo)" alt="Logo" style="max-width: 60%; max-height: 40px;"/>
                                    </div>

                                    <!-- Datos de la empresa -->
                                    <div style="font-size: 8px; font-weight: bold;">
                                        <div t-if="res_company.name">
                                            <span t-field="res_company.name"/>
                                        </div>
                                        <div t-if="res_company.street or res_company.zip or res_company.city">
                                            <span t-if="res_company.street" t-field="res_company.street"/><t t-if="res_company.street">. </t>
                                            <span t-if="res_company.zip" t-field="res_company.zip"/>
                                            <span t-if="res_company.city" t-field="res_company.city"/>
                                        </div>
                                        <div style="margin-top: 2px;">
                                            <span t-if="res_company.phone">TLF.: <span t-field="res_company.phone"/></span>
                                            <span t-if="res_company.vat" style="margin-left: 10px;">N.I.F.: <span t-field="res_company.vat"/></span>
                                        </div>
                                    </div>
                                </div>

                                <hr style="border: 0; border-top: 2px solid black; margin: 5px 0;"/>

                                <!-- Dirección de entrega/cliente - PEGADO A LA IZQUIERDA -->
                                <div style="font-size: 8px; margin-bottom: 5px; text-align: left;">
                                    <t t-if="o.picking_type_id.code=='outgoing' and partner">
                                        <div style="font-weight: bold; margin-bottom: 3px;">Cliente:</div>
                                        <div t-if="partner.name"><span t-field="partner.name"/></div>
                                        <div t-if="partner.street">
                                            <span t-field="partner.street"/><t t-if="partner.zip or partner.city">. </t>
                                            <span t-if="partner.zip" t-field="partner.zip"/>
                                            <span t-if="partner.city" t-field="partner.city"/>
                                        </div>
                                        <div style="margin-top: 2px;">
                                            <span t-if="partner.phone">TLF.: <span t-field="partner.phone"/></span>
                                        </div>
                                        <div t-if="partner.vat">
                                            <span>N.I.F.: <span t-field="partner.vat"/></span>
                                        </div>
                                    </t>
                                    <t t-if="o.picking_type_id.code=='incoming' and partner">
                                        <div style="font-weight: bold; margin-bottom: 3px;">Proveedor:</div>
                                        <div t-if="partner.name"><span t-field="partner.name"/></div>
                                        <div t-if="partner.street">
                                            <span t-field="partner.street"/><t t-if="partner.zip or partner.city">. </t>
                                            <span t-if="partner.zip" t-field="partner.zip"/>
                                            <span t-if="partner.city" t-field="partner.city"/>
                                        </div>
                                        <div style="margin-top: 2px;">
                                            <span t-if="partner.phone">TLF.: <span t-field="partner.phone"/></span>
                                        </div>
                                        <div t-if="partner.vat">
                                            <span>N.I.F.: <span t-field="partner.vat"/></span>
                                        </div>
                                    </t>
                                </div>

                                <!-- Información del documento -->
                                <div style="font-size: 8px; margin-top: 8px; margin-bottom: 5px;">
                                    <div style="font-weight: bold;">
                                        <span t-if="o.picking_type_id.code == 'outgoing'">Albarán de entrega: </span>
                                        <span t-if="o.picking_type_id.code == 'incoming'">Albarán de recepción: </span>
                                        <span t-field="o.name"/>
                                    </div>
                                    <div t-if="o.origin">
                                        <strong>Pedido:</strong> <span t-field="o.origin"/>
                                    </div>
                                    <div>
                                        <strong>Fecha:</strong>
                                        <t t-if="o.state == 'done'">
                                            <span t-field="o.date_done" t-options='{"widget": "date"}'/>
                                        </t>
                                        <t t-if="o.state != 'done'">
                                            <span t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                                        </t>
                                    </div>
                                </div>

                                <hr style="border: 0; border-top: 2px solid black; margin: 5px 0;"/>

                                <!-- Tabla cuando NO está done -->
                                <table t-if="o.state!='done'" name="stock_move_table" style="font-size: 8px; margin-top: 5px; width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="border-bottom: 1px solid black;">
                                            <th name="th_sm_product" style="padding: 2px; text-align: left;"><strong>Producto</strong></th>
                                            <th name="th_sm_quantity" style="padding: 2px; text-align: right;"><strong>Cant.</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                        <tr t-foreach="lines" t-as="move">
                                            <td style="padding: 2px;">
                                                <span t-field="move.product_id"/>
                                                <p t-if="move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name" style="font-size: 7px; margin: 0;">
                                                    <span t-field="move.description_picking"/>
                                                </p>
                                            </td>
                                            <td style="padding: 2px; text-align: right;">
                                                <span t-field="move.product_uom_qty"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Tabla cuando está DONE -->
                                <table t-if="o.move_line_ids and o.state=='done'" name="stock_move_line_table" style="font-size: 8px; margin-top: 5px; width: 100%; border-collapse: collapse;">
                                    <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')" groups="stock.group_lot_on_delivery_slip"/>
                                    <thead>
                                        <tr style="border-bottom: 1px solid black;">
                                            <th name="th_sml_product" style="padding: 2px; text-align: left;"><strong>Producto</strong></th>
                                            <th name="th_sml_quantity" style="padding: 2px; text-align: right;"><strong>Entregado</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities()"/>
                                        <tr t-foreach="aggregated_lines" t-as="line">
                                            <td style="padding: 2px;">
                                                <span t-esc="line['name']"/>
                                                <p t-if="line.get('description')" style="font-size: 7px; margin: 0;">
                                                    <span t-esc="line['description']"/>
                                                </p>
                                            </td>
                                            <td style="padding: 2px; text-align: right;">
                                                <span t-esc="line['quantity']"/>
                                                <span t-if="line.get('uom')" t-esc="line['uom']"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <hr style="border: 0; border-top: 2px solid black; margin: 5px 0;"/>

                                <!-- Backorders -->
                                <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                                <t t-if="o.backorder_ids and backorders">
                                    <p style="font-size: 7px; margin-top: 5px; margin-bottom: 3px;">
                                        <span>Cantidades pendientes:</span>
                                    </p>
                                    <table name="stock_backorder_table" style="font-size: 7px; width: 100%; border-collapse: collapse;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid black;">
                                                <th name="th_sb_product" style="padding: 2px; text-align: left;"><strong>Producto</strong></th>
                                                <th name="th_sb_quantity" style="padding: 2px; text-align: right;"><strong>Cant.</strong></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="backorders" t-as="backorder">
                                                <t t-set="bo_lines" t-value="backorder.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                                <tr t-foreach="bo_lines" t-as="bo_line">
                                                    <td style="padding: 2px;">
                                                        <span t-field="bo_line.product_id"/>
                                                    </td>
                                                    <td style="padding: 2px; text-align: right;">
                                                        <span t-field="bo_line.product_uom_qty"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>

                                <!-- Firma -->
                                <div t-if="o.signature" style="margin-top: 10px; font-size: 8px;" name="signature">
                                    <hr style="border: 0; border-top: 1px solid black; margin: 5px 0;"/>
                                    <div style="text-align: center; font-weight: bold;">Firma del receptor</div>
                                    <div style="text-align: center; margin-top: 5px;">
                                        <img t-att-src="image_data_uri(o.signature)" style="max-height: 2.5cm; max-width: 100%;"/>
                                    </div>
                                    <div style="text-align: center; margin-top: 3px;">
                                        <p t-field="o.partner_id.name" style="margin: 0;"/>
                                    </div>
                                </div>

                            </div>
                        </main>
                    </div>
                </t>
            </t>
        </template>

        <!-- Reporte de albarán con formato Bluetooth -->
        <record id="action_report_picking_bluetooth" model="ir.actions.report">
            <field name="name">Albarán Bluetooth</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">calatayud_document_format.report_picking_bluetooth_document</field>
            <field name="report_file">calatayud_document_format.report_picking_bluetooth_document</field>
            <field name="print_report_name">'Albarán - %s' % (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="bluetooth_delivery_2"/>
        </record>

    </data>
</odoo>
