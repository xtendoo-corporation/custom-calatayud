<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="extended_signup" inherit_id="auth_signup.signup">

        <xpath expr="//form[hasclass('oe_signup_form')]" position="attributes">
            <attribute name="action">/website/form/mail.mail</attribute>
            <attribute name="method">post</attribute>
            <attribute name="enctype">multipart/form-data</attribute>
            <attribute name="class">oe_signup_form o_mark_required text-start</attribute>
            <attribute name="data-mark">*</attribute>
            <attribute name="data-pre-fill">true</attribute>
            <attribute name="data-success-mode">redirect</attribute>
            <attribute name="data-success-page">/contactus-thank-you</attribute>
            <attribute name="data-model_name">mail.mail</attribute>
            <attribute name="class">o_mark_required text-start w-100</attribute>
        </xpath>
        <xpath expr="//t[@t-call='auth_signup.fields']" position="replace">
            <div class="container-fluid px-4" style="width:60vw">
                <div class="row mt-5">
                    <div class="col-12">
                        <h3 class="text-center mb-4">Formulario de registro para profesionales del sector textil</h3>
                        <input type="hidden" class="form-control s_website_form_input" name="email_to"
                               value="altas@almacenescalatayud.com"/>
                        <input type="hidden" name="subject" value="Solicitud de alta como distribuidor"/>
                        <div class="mb-3 col-12">
                            <label class="form-label">Nombre *</label>
                            <input type="text" name="nombre_fiscal" class="form-control" required="required"/>
                        </div>
                        <div class="mb-3 col-12">
                            <label class="form-label">Correo Electrónico *</label>
                            <input type="email" name="email_from" class="form-control" required="required"/>
                        </div>
                        <div class="mb-3 col-12">
                            <label class="form-label">Teléfono</label>
                            <input type="text" name="telefono" class="form-control" required="required"/>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" name="privacidad" class="form-check-input" required="required"/>
                            <label class="form-check-label">Acepto la política de privacidad *</label>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//button[@type='submit']" position="replace">
            <button type="submit" class="w-25 btn btn-dark s_website_form_send mx-auto d-block mb-2">ENVIAR</button>
            <script>
                document.querySelector('form').addEventListener('submit', function(event) {
                event.preventDefault();
                var form = event.target;

                // Realiza el envío del formulario de forma normal
                var formData = new FormData(form);
                fetch(form.action, {
                method: 'POST',
                body: formData
                })
                .then(function(response) {
                if (response.ok) {
                // Redirigir después de que el formulario se haya enviado con éxito
                window.location.href = '/contactus-thank-you';
                } else {
                alert('Hubo un error al enviar el formulario.');
                }
                })
                .catch(function(error) {
                console.error('Error en la solicitud:', error);
                });
                });
            </script>
        </xpath>
    </template>
    <template id="login_clear" inherit_id="auth_signup.login">
        <xpath expr="//div[hasclass('justify-content-between') and hasclass('mt-2')]"
               position="replace">
        </xpath>
    </template>
    <template id="login_custom" inherit_id="web.login" name="Custom Login - Add Message Above Email">
        <xpath expr="//div[hasclass('field-login')]" position="before">

        </xpath>
    </template>

    <template id="custom_web_login_two_columns" inherit_id="web.login">
        <xpath expr="//form[hasclass('oe_login_form')]" position="replace">
                <div class="container-fluid d-flex justify-content-center align-items-center"
                     style="min-height: 90vh;
                        background-image: url('/website_login_fix/static/src/img/img.png');
                        background-size: cover;
                        background-position: center;
                        background-repeat: no-repeat;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">

                    <!-- Columna izquierda: Login - Con imagen de fondo -->
                    <div class="row justify-content-center align-items-center w-100">
                        <div class="col-md-5 mx-4">
                            <div style="background-color: rgba(255, 255, 255, 1);
                                        padding: 30px;
                                        border-radius: 8px;
                                        text-align: left;
                                        min-height: 800px;
                                        min-width: 400px;">
                                <h2 class="mb-4"
                                    style="text-align: center; font-weight: bold; font-size: 28px; color: #333;">
                                    Almacenes Calatayud
                                </h2>
                                <h5 class="mb-4" style="text-align: left; color: #555;">
                                    La plataforma líder para profesionales del sector textil.
                                    <br/><br/>
                                    Desde Almacenes Calatayud podrá gestionar todos sus pedidos, consultar nuestro amplio
                                    catálogo de productos textiles, revisar precios especiales para profesionales y realizar sus compras de manera rápida y
                                    sencilla desde cualquier dispositivo.
                                    <br/><br/>
                                    Si ya tiene una cuenta, inicie sesión con sus credenciales:
                                </h5>
                                <form class="m-0" role="form" t-attf-action="/web/login" method="post"
                                      onsubmit="this.action = '/web/login' + location.hash" style="text-align: left;">

                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3 d-none" t-if="databases and len(databases) &gt; 1">
                                        <label for="db" class="col-form-label">Base de Datos</label>
                                        <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                                            <input type="text" name="db" t-att-value="request.db" id="db"
                                                   t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                   required="required" readonly="readonly"/>
                                            <a role="button" href="/web/database/selector" class="btn btn-secondary">
                                                Seleccionar
                                                <i class="fa fa-database" role="img" aria-label="Database"
                                                   title="Database"/>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mb-3 field-login" style="text-align: left;">
                                        <label for="login" class="form-label" style="text-align: left;">Email</label>
                                        <input type="text" placeholder="Email" name="login" t-att-value="login" id="login"
                                               t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                               required="required" autocomplete="username" autofocus="autofocus"
                                               autocapitalize="off"/>
                                    </div>
                                    <div class="mb-3" style="text-align: left;">
                                        <label for="password" class="form-label" style="text-align: left;">Contraseña</label>
                                        <input type="password" placeholder="Contraseña" name="password" id="password"
                                               t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                               required="required" autocomplete="current-password"
                                               t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                                    </div>
                                    <p class="alert alert-danger" t-if="error" role="alert">
                                        <t t-esc="error"/>
                                    </p>
                                    <p class="alert alert-success" t-if="message" role="status">
                                        <t t-esc="message"/>
                                    </p>
                                    <div
                                        t-attf-class="clearfix oe_login_buttons d-grid mb-1 {{'pt-2' if form_small else 'pt-3'}}"
                                        style="text-align: left;">
                                        <button type="submit" class="btn btn-dark s_website_form_send mb-2" style="width: 20%;">
                                            Iniciar sesión
                                        </button>
                                        <t t-if="debug">
                                            <button type="submit" name="redirect" value="/web/become"
                                                    class="btn btn-link btn-sm d-none">Log in as superuser
                                            </button>
                                        </t>
                                        <div class="o_login_auth"/>
                                    </div>
                                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                                </form>

                            </div>

                        </div>

                        <!-- Columna derecha: Formulario de registro - Con imagen de fondo -->
                        <div class="col-md-5 mx-4">

                            <div style="background-color: rgba(255, 255, 255, 1);
                                        padding: 30px;
                                        border-radius: 8px;
                                        text-align: left;
                                        min-height: 800px;">
                                <h2 style="text-align: center; font-weight: bold; font-size: 28px; color: #333;">
                                    ¿Todavía no tiene cuenta en Almacenes Calatayud?
                                </h2>
                                <h5 class="mb-4" style="color: #555;">
                                    <br/>Rellene el siguiente formulario y crearemos una cuenta para su negocio:
                                </h5>

                                <form action="/website/form/mail.mail" method="post" enctype="multipart/form-data"
                                      class="o_mark_required w-100 m-0"
                                      data-mark="*" data-pre-fill="true" data-success-mode="redirect"
                                      data-success-page="/contactus-thank-you" data-model_name="mail.mail"> <!-- oe_signup_form-->
                                    <input type="hidden" class="form-control s_website_form_input" name="email_to"
                                           value="altas@almacenescalatayud.com"/>
                                    <input type="hidden" name="subject" value="Solicitud de alta como distribuidor"/>

                                    <div class="mb-3">
                                        <label class="form-label" style="display: block; text-align: left;">Nombre Fiscal
                                            *
                                        </label>
                                        <input type="text" name="nombre_fiscal" placeholder="Nombre fiscal" class="form-control" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" style="display: block; text-align: left;">Email *
                                        </label>
                                        <input type="email" name="email_from" placeholder="Email" class="form-control" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" style="display: block; text-align: left;">Teléfono</label>
                                        <input type="text" name="telefono"  placeholder="Teléfono" class="form-control"/>
                                    </div>
                                    <div class="mb-3 form-check">
                                        <input type="checkbox" name="privacidad" class="form-check-input"
                                               required="required"/>
                                        <label class="form-check-label">Acepto la política de privacidad *</label>
                                    </div>
                                    <button type="submit" class="btn btn-dark s_website_form_send mb-2" style="width: 15%;">
                                        Enviar
                                    </button>
                                    <script>
                                        document.querySelector('form').addEventListener('submit', function(event) {
                                        event.preventDefault();
                                        var form = event.target;
                                        var formData = new FormData(form);
                                        fetch(form.action, {
                                        method: 'POST',
                                        body: formData
                                        })
                                        .then(function(response) {
                                        if (response.ok) {
                                        window.location.href = '/contactus-thank-you';
                                        } else {
                                        alert('Hubo un error al enviar el formulario.');
                                        }
                                        })
                                        .catch(function(error) {
                                        console.error('Error en la solicitud:', error);
                                        });
                                        });
                                    </script>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
        </xpath>
    </template>

</odoo>
