<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="extended_signup" inherit_id="auth_signup.signup">

        <xpath expr="//form[@class='oe_signup_form']" position="attributes">
            <attribute name="action">/website/form/mail.mail</attribute>
            <attribute name="method">post</attribute>
            <attribute name="enctype">multipart/form-data</attribute>
            <attribute name="class">oe_signup_form o_mark_required text-start</attribute>
            <attribute name="data-mark">*</attribute>
            <attribute name="data-pre-fill">true</attribute>
            <attribute name="data-success-mode">redirect</attribute>
            <attribute name="data-success-page">/contactus-thank-you</attribute>
            <attribute name="data-model_name">mail.mail</attribute>
            <attribute name="class">o_mark_required text-start w-100</attribute>
        </xpath>
        <xpath expr="//t[@t-call='auth_signup.fields']" position="replace">
            <div class="container-fluid px-4" style="width:60vw">
                <div class="row mt-5">
                    <div class="col-12">
                        <h2 class="text-center mb-4">Formulario de registro para profesionales del sector textil</h2>
                        <input type="hidden" class="form-control s_website_form_input" name="email_to"
                               value="altas@almacenescalatayud.com"/>
                        <input type="hidden" name="subject" value="Solicitud de alta como distribuidor"/>
                        <div class="mb-3">
                            <label class="form-label">Nombre Fiscal *</label>
                            <input type="text" name="nombre_fiscal" class="form-control" required="required"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Calle y número *</label>
                            <input type="text" name="direccion" class="form-control" required="required"/>
                        </div>
                        <div class="row mb-3">
                            <div class="col-3">
                                <label class="form-label">Codigo postal *</label>
                                <input type="text" name="direccion" class="form-control" required="required"/>
                            </div>
                            <div class="col-9">
                                <label class="form-label">Ciudad *</label>
                                <input type="text" name="direccion" class="form-control" required="required"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Provincia *</label>
                            <input type="text" name="direccion" class="form-control" required="required"/>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">Correo Electrónico *</label>
                                <input type="email" name="email_from" class="form-control" required="required"/>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Teléfono *</label>
                                <input type="text" name="telefono" class="form-control" required="required"/>
                            </div>
                        </div>
                        <div class="mb-3 field-cif">
                            <label for="cif" class="form-label">CIF *</label>
                            <input type="text" name="cif" t-att-value="cif" id="cif"
                                   class="form-control" placeholder="ej. B12345678"
                                   required="required"/>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" name="es_cliente" class="form-check-input"/>
                            <label class="form-check-label">¿Eres cliente de Almacenes Calatayud?</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Asunto</label>
                            <input type="text" name="asunto" class="form-control"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Documentos</label>
                            <input type="file" name="attachments[]" class="form-control"
                                   multiple="multiple" accept=".pdf,.doc,.docx"/>
                            <small class="form-text text-muted">Puede adjuntar múltiples documentos (PDF, DOC, DOCX)
                            </small>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" name="privacidad" class="form-check-input" required="required"/>
                            <label class="form-check-label">Acepto la política de privacidad *</label>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//button[@type='submit']" position="replace">

            <button type="submit" class="w-25 btn btn-dark s_website_form_send mx-auto d-block mb-2">ENVIAR</button>
            <script>
                document.querySelector('form').addEventListener('submit', function(event) {
                event.preventDefault();
                var form = event.target;

                // Realiza el envío del formulario de forma normal
                var formData = new FormData(form);
                fetch(form.action, {
                method: 'POST',
                body: formData
                })
                .then(function(response) {
                if (response.ok) {
                // Redirigir después de que el formulario se haya enviado con éxito
                window.location.href = '/contactus-thank-you';
                } else {
                alert('Hubo un error al enviar el formulario.');
                }
                })
                .catch(function(error) {
                console.error('Error en la solicitud:', error);
                });
                });
            </script>
        </xpath>
    </template>
    <template id="login_clear" inherit_id="auth_signup.login">
        <xpath expr="//div[contains(@class, 'justify-content-between') and contains(@class, 'mt-2')]"
               position="replace">
        </xpath>
    </template>
    <template id="login_custom" inherit_id="web.login" name="Custom Login - Add Message Above Email">
        <xpath expr="//div[contains(@class, 'field-login')]" position="before">

        </xpath>
    </template>

    <template id="login_custom2" inherit_id="web.login" name="Custom Login - Add Message Below Email">
        <xpath expr="//button[@type='submit' and @class='btn btn-primary']" position="after">
            <div class="text-center oe_login_buttons mt-4">
                <a t-if="signup_enabled" t-attf-href="/web/signup?{{ keep_query() }}" class="btn btn-primary">
                    Si eres profesional del sector textil, crea una cuenta
                </a>
            </div>
        </xpath>
    </template>
</odoo>

