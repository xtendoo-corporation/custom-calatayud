<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_options_template" name="Opciones de acceso">
        <t t-call="website.layout">
            <div class="container-fluid d-flex justify-content-center align-items-center"
                 style="min-height: 90vh;
                    background-image: url('/website_login_fix/static/src/img/img.png');
                    background-size: cover;
                    background-position: center;
                    background-repeat: no-repeat;
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">

                <!-- Columna izquierda: Login - Con imagen de fondo -->
                <div class="row justify-content-center align-items-center w-100">
                    <div class="col-md-5 mx-4">
                        <div style="background-color: rgba(255, 255, 255, 1);
                                    padding: 30px;
                                    border-radius: 8px;
                                    text-align: left;
                                    min-height: 800px;
                                    min-width: 400px;">
                            <h2 class="mb-4"
                                style="text-align: center; font-weight: bold; font-size: 28px; color: #333;">
                                Almacenes Calatayud
                            </h2>
                            <h5 class="mb-4" style="text-align: left; color: #555;">
                                La plataforma líder para profesionales del sector textil.
                                <br/>
                                <br/>
                                Desde Almacenes Calatayud podrá gestionar todos sus pedidos, consultar nuestro
                                amplio
                                catálogo de productos textiles, revisar precios especiales para profesionales y
                                realizar
                                sus compras de manera rápida y
                                sencilla desde cualquier dispositivo.
                                <br/>
                                <br/>
                                Si ya tiene una cuenta, inicie sesión con sus credenciales:
                            </h5>
                            <div class="text-left mt-4">
                                <a href="/web/login" class="btn btn-dark" style="width: 20%;">Iniciar Sesión</a>
                            </div>
                        </div>
                    </div>

                    <!-- Columna derecha: Formulario de registro - Con imagen de fondo -->
                    <div class="col-md-5 mx-4">
                        <div style="background-color: rgba(255, 255, 255, 1);
                                    padding: 30px;
                                    border-radius: 8px;
                                    text-align: left;
                                    min-height: 800px;">
                            <h2 style="text-align: center; font-weight: bold; font-size: 28px; color: #333;">
                                ¿Todavía no tiene cuenta en Almacenes Calatayud?
                            </h2>
                            <h5 class="mb-4" style="color: #555;">
                                <br/>Rellene el siguiente formulario y crearemos una cuenta para su negocio:
                            </h5>

                            <form action="/website/form/" method="post" enctype="multipart/form-data"
                                  class="o_mark_required w-100 m-0 s_website_form"
                                  data-mark="*" data-pre-fill="true" data-success-mode="redirect"
                                  data-success-page="/contactus-thank-you"
                                  data-model_name="mail.mail">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" class="s_website_form_input" name="email_to"
                                       value="altas@almacenescalatayud.com"/>
                                <input type="hidden" class="s_website_form_input" name="subject" value="Solicitud de alta como distribuidor"/>

                                <div class="mb-3">
                                    <label class="form-label" style="display: block; text-align: left;">Nombre
                                        Fiscal
                                        *
                                    </label>
                                    <input type="text" name="nombre_fiscal" placeholder="Nombre fiscal"
                                           class="form-control s_website_form_input" data-fill-with="nombre_fiscal"
                                           required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="display: block; text-align: left;">Email *
                                    </label>
                                    <input type="email" name="email_from" placeholder="Email" class="form-control s_website_form_input" data-fill-with="email_from"
                                           required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="display: block; text-align: left;">Teléfono
                                    </label>
                                    <input type="text" name="telefono" placeholder="Teléfono" class="form-control s_website_form_input" data-fill-with="telefono"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="display: block; text-align: left;">Mensaje (opcional)
                                    </label>
                                    <textarea name="mensaje" placeholder="Escriba su mensaje aquí..." class="form-control s_website_form_input" rows="4" data-fill-with="body_html"></textarea>
                                </div>
                                <div class="mb-3 form-check">
                                    <input type="checkbox" name="privacidad" class="form-check-input"
                                           required="required"/>
                                    <label class="form-check-label">Acepto la política de privacidad *</label>
                                </div>
                                <button type="submit" class="btn btn-dark s_website_form_send mb-2"
                                        style="width: 15%;">
                                    Enviar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="show_login_message" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <style>
                html[data-logged="false"][data-website-id="1"] .o_wsale_products_item_title::after,
                html[data-logged="false"][data-website-id="1"] #product_details h1::after {
                content: "🔒 Inicia sesión para ver precios";
                display: block;
                color: #6c757d;
                font-size: 0.875rem;
                font-style: italic;
                margin-top: 0.5rem;
                font-weight: normal;
                }
            </style>
        </xpath>
    </template>

    <!-- Eliminar el enlace "Don't have an account?" -->
    <template id="remove_signup_link" inherit_id="auth_signup.login" name="Remove Signup Link">
        <xpath expr="//p[@class='mt-2 text-center']" position="replace"/>
    </template>

    <!-- Eliminar el enlace de login como superusuario -->
    <template id="remove_superuser_login" inherit_id="web.login" name="Remove Superuser Login">
        <xpath expr="//div[@class='o_login_auth']" position="replace"/>
    </template>
</odoo>
