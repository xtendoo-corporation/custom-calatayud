<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_pricelist_security" model="ir.ui.view">
        <field name="name">res.partner.product.property.form.pricelist.security</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="product.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_product_pricelist']" position="attributes">
                <attribute name="groups">calatayud_pricelist_security.group_pricelist_access,base.group_system</attribute>
            </xpath>
            <xpath expr="//div[@name='parent_pricelists']" position="attributes">
                <attribute name="groups">calatayud_pricelist_security.group_pricelist_access,base.group_system</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_pricelist_security" model="ir.ui.view">
        <field name="name">product.template.form.pricelist.security</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_pricelist_rules']" position="attributes">
                <attribute name="groups">calatayud_pricelist_security.group_pricelist_access,base.group_system</attribute>
            </xpath>
        </field>
    </record>


    <record id="res_config_settings_view_form_pricelist_security" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pricelist.security</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(product.product_pricelist_action2)d']" position="attributes">
                <attribute name="groups">calatayud_pricelist_security.group_pricelist_access,base.group_system</attribute>
            </xpath>
        </field>
    </record>
</odoo>

