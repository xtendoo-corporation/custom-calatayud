<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pricelist_security" model="ir.ui.view">
        <field name="name">product.template.form.pricelist.security</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_pricelist_rules']" position="attributes">
                <attribute name="groups">calatayud_pricelist_security.group_pricelist_access,product.group_sale_pricelist</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_tree_pricelist_security" model="ir.ui.view">
        <field name="name">product.pricelist.tree.pricelist.security</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="visible_to_basic_users" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_form_pricelist_security" model="ir.ui.view">
        <field name="name">product.pricelist.form.pricelist.security</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']/field[@name='company_id']" position="after">
                <field name="visible_to_basic_users"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_search_pricelist_security" model="ir.ui.view">
        <field name="name">product.pricelist.search.pricelist.security</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter
                    string="Visibles para usuarios básicos"
                    name="visible_to_basic_users"
                    domain="[('visible_to_basic_users', '=', True)]"
                />
            </xpath>
        </field>
    </record>


    <record id="res_config_settings_view_form_pricelist_security" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pricelist.security</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(product.product_pricelist_action2)d']" position="attributes">
                <attribute name="groups">calatayud_pricelist_security.group_pricelist_access,product.group_sale_pricelist</attribute>
            </xpath>
        </field>
    </record>
</odoo>

