<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_pricelist_access" model="res.groups">
            <field name="name">Acceso avanzado a listas de precios</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('product.group_product_pricelist')), (4, ref('product.group_sale_pricelist'))]"/>
        </record>

        <record id="rule_pricelist_internal_users_basic" model="ir.rule">
            <field name="name">Pricelists visible for basic internal users</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('visible_to_basic_users', '=', True)]</field>
        </record>

        <record id="rule_pricelist_internal_users_advanced" model="ir.rule">
            <field name="name">Pricelists visible for advanced users</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="groups" eval="[(4, ref('calatayud_pricelist_security.group_pricelist_access')), (4, ref('product.group_sale_pricelist'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_pricelist_item_internal_users_basic" model="ir.rule">
            <field name="name">Pricelist items visible for basic internal users</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('pricelist_id.visible_to_basic_users', '=', True)]</field>
        </record>

        <record id="rule_pricelist_item_internal_users_advanced" model="ir.rule">
            <field name="name">Pricelist items visible for advanced users</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="groups" eval="[(4, ref('calatayud_pricelist_security.group_pricelist_access')), (4, ref('product.group_sale_pricelist'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="product.access_product_pricelist_user" model="ir.model.access">
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="product.access_product_pricelist_item_user" model="ir.model.access">
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="product.access_product_pricelist_partner_manager" model="ir.model.access">
            <field name="group_id" ref="base.group_partner_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="access_product_pricelist_advanced_user" model="ir.model.access">
            <field name="name">product.pricelist.advanced.user</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="group_id" ref="calatayud_pricelist_security.group_pricelist_access"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="access_product_pricelist_odoo_advanced_user" model="ir.model.access">
            <field name="name">product.pricelist.odoo.advanced.user</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="group_id" ref="product.group_sale_pricelist"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="access_product_pricelist_item_advanced_user" model="ir.model.access">
            <field name="name">product.pricelist.item.advanced.user</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="group_id" ref="calatayud_pricelist_security.group_pricelist_access"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="access_product_pricelist_item_odoo_advanced_user" model="ir.model.access">
            <field name="name">product.pricelist.item.odoo.advanced.user</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="group_id" ref="product.group_sale_pricelist"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="product.product_pricelist_action2" model="ir.actions.act_window">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('product.group_sale_pricelist')])]"/>
        </record>

        <record id="product.product_pricelist_item_action" model="ir.actions.act_window">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('product.group_sale_pricelist')])]"/>
        </record>

        <record id="product.action_product_template_price_list_report" model="ir.actions.server">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('product.group_sale_pricelist')])]"/>
        </record>

        <record id="product.action_product_price_list_report" model="ir.actions.server">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('product.group_sale_pricelist')])]"/>
        </record>

        <record id="sale.menu_product_pricelist_main" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('product.group_sale_pricelist')])]"/>
        </record>
    </data>
</odoo>

