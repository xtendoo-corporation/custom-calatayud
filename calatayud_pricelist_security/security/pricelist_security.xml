<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_pricelist_access" model="res.groups">
            <field name="name">Acceso a listas de precios</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('product.group_product_pricelist'))]"/>
        </record>

        <record id="rule_pricelist_internal_users_deny" model="ir.rule">
            <field name="name">Pricelists denied for internal users by default</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
        </record>

        <record id="rule_pricelist_internal_users_allow" model="ir.rule">
            <field name="name">Pricelists allowed for authorized internal users</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="groups" eval="[(4, ref('calatayud_pricelist_security.group_pricelist_access')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_pricelist_item_internal_users_deny" model="ir.rule">
            <field name="name">Pricelist items denied for internal users by default</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
        </record>

        <record id="rule_pricelist_item_internal_users_allow" model="ir.rule">
            <field name="name">Pricelist items allowed for authorized internal users</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="groups" eval="[(4, ref('calatayud_pricelist_security.group_pricelist_access')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="product.access_product_pricelist_user" model="ir.model.access">
            <field name="group_id" ref="calatayud_pricelist_security.group_pricelist_access"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="product.access_product_pricelist_item_user" model="ir.model.access">
            <field name="group_id" ref="calatayud_pricelist_security.group_pricelist_access"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="product.access_product_pricelist_partner_manager" model="ir.model.access">
            <field name="group_id" ref="calatayud_pricelist_security.group_pricelist_access"/>
        </record>

        <record id="product.product_pricelist_action2" model="ir.actions.act_window">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('base.group_system')])]"/>
        </record>

        <record id="product.product_pricelist_item_action" model="ir.actions.act_window">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('base.group_system')])]"/>
        </record>

        <record id="product.action_product_template_price_list_report" model="ir.actions.server">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('base.group_system')])]"/>
        </record>

        <record id="product.action_product_price_list_report" model="ir.actions.server">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('base.group_system')])]"/>
        </record>

        <record id="sale.menu_product_pricelist_main" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('calatayud_pricelist_security.group_pricelist_access'), ref('base.group_system')])]"/>
        </record>
    </data>
</odoo>

