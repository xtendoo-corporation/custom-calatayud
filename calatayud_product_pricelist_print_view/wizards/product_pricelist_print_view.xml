<odoo>

    <record id="view_product_pricelist_print" model="ir.ui.view">
        <field name="model">product.pricelist.print</field>
        <field
            name="inherit_id"
            ref="product_pricelist_direct_print.view_product_pricelist_print"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_product_uom']" position="after">
                <field name="description_product"/>
            </xpath>
            <xpath expr="//field[@name='show_pricelist_name']" position="after">
                <field name="show_pieces"/>
            </xpath>
            <!-- La expresión original `categ_ids != []` se evalúa como True en
                 el cliente web (py.js compara listas por referencia), lo que
                 oculta siempre la pestaña Productos. Se reescribe sin `!= []`. -->
            <xpath
                expr="//field[@name='product_tmpl_ids']/parent::page"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >categ_ids or last_ordered_products != 0 or context_active_model in ['product.template','product.product']</attribute>
            </xpath>
        </field>
    </record>

</odoo>

