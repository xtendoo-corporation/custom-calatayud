<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_out_of_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.out.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="hide_add_to_cart_setting" position="after">
                <setting id="default_out_of_stock_message_setting"
                         string="Mensaje de sin stock"
                         help="Mensaje predeterminado mostrado en la tienda para los productos sin stock que no tengan configurado su propio mensaje">
                    <field name="website_default_out_of_stock_message"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
