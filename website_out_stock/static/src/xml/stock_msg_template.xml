<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="website_sale_stock.product_availability"
     t-inherit-mode="extension">
    <xpath expr="//div[@id='threshold_message']" position="replace">
      <div id="threshold_message"
           t-if="show_availability and free_qty &lt;= available_threshold"
           t-attf-class="availability_message_#{product_template} text-warning fw-bold">
        Unidades en stock:
        <strong><t t-esc="formatQuantity(free_qty)"/></strong>
      </div>
    </xpath>
    <xpath expr="//div[@id='out_of_stock_message']" position="replace">
      <div id="out_of_stock_message">
        <div t-if="has_out_of_stock_message"
             class="alert alert-warning d-flex align-items-center gap-2 mb-2 py-2"
             role="alert">
          <i class="fa fa-exclamation-triangle"/>
          <t t-out="out_of_stock_message"/>
        </div>
        <div t-elif="!allow_out_of_stock_order"
             class="alert alert-danger d-flex align-items-center gap-2 mb-2 py-2"
             role="alert">
          <i class="fa fa-times"/>
          <span>Out of Stock</span>
        </div>
      </div>
    </xpath>
  </t>
</templates>
