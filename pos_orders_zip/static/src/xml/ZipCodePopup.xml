<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_orders_zip.ZipCodeConfirmationDialog" t-inherit="web.ConfirmationDialog">
        <xpath expr="//div[@class='modal-body']" position="inside">
            <div class="mt-3">
                <label for="zipcode-input" class="form-label">Código Postal:</label>
                <input
                    id="zipcode-input"
                    type="text"
                    class="form-control"
                    t-model="state.zipCode"
                    placeholder="Introduzca el código postal (opcional)"
                    maxlength="10"
                    autofocus="autofocus"/>
                <small class="text-muted">Entre 4 y 10 caracteres</small>
            </div>
        </xpath>
    </t>
</templates>
