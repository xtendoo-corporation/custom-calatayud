<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Lista personalizada -->
        <record id="view_account_move_customer_list" model="ir.ui.view">
            <field name="name">account.move.customer.list</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="Facturas del Cliente" create="false">
                    <field name="name"/>
                    <field name="invoice_date"/>
                    <field name="invoice_date_due"/>
                    <field name="amount_total" sum="Total Facturado"/>
                    <field name="amount_residual" sum="Total Pendiente"/>
                    <field name="currency_id"/>
                    <field name="payment_state"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record id="action_customer_invoices" model="ir.actions.act_window">
            <field name="name">Facturas Cliente</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_account_move_customer_list"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
           <field name="context">{'search_default_open': 1, 'search_default_unpaid': 1}</field>
        </record>
    </data>
</odoo>
