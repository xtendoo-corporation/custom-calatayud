<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista heredada para agregar el smart button -->
        <record id="view_partner_form_payment_button" model="ir.ui.view">
            <field name="name">res.partner.form.payment.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button"
                            type="object"
                            name="action_view_customer_payments"
                            invisible="not is_company or customer_rank == 0 or payment_count == 0"
                            icon="fa-file-text-o">
                        <field name="payment_count" widget="statinfo" string="Facturas"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>
