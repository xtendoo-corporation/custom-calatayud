<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para mostrar efectos del cliente -->
    <record model="ir.actions.act_window" id="action_customer_effects">
        <field name="name">Efectos del Cliente</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{
            'search_default_posted_moves': 1,
            'search_default_from_invoices': 1,
            'search_default_not_full_reconciled': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('account_due_list.view_payments_tree')})]"/>
        <field name="search_view_id" ref="account_due_list.view_payments_filter"/>
        <field name="domain">[
            ('account_id.reconcile', '=', True),
            ('balance', '!=', 0),
            ('partner_id', '=', active_id)
        ]</field>
    </record>

    <!-- Smart button en la vista del cliente -->
    <record model="ir.ui.view" id="res_partner_effects_button">
        <field name="name">res.partner.effects.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(action_customer_effects)d"
                    icon="fa-money"
                    groups="account.group_account_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">Efectos</span>
                        <span class="o_stat_text">Ver Todos</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
