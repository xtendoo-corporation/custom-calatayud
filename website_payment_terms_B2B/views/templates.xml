<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_custom" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="replace">
            <t t-if="request.website.id == 1">
                <div id="payment_method" class="mt-3">
                    <h3 class="mb24">Pedir con</h3>
                    <div class="o_not_editable">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="payment_option_name">
                                        <b t-field="user_id.partner_id.customer_payment_mode_id.sudo().name"/>,
                                        <b t-field="user_id.partner_id.property_payment_term_id.sudo().name"/>
                                    </span>
                                    <form action="/shop/payment/validate/custom" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-check"/>
                                            Confirmar Pedido
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div t-if="providers or tokens" id="payment_method" class="mt-3">
                    <h3 class="mb24">Pagar con</h3>
                    <div class="o_not_editable">
                        <t t-call="payment.checkout">
                            <t t-set="footer_template_id" t-value="'website_sale.payment_footer'"/>
                            <t t-set="submit_button_label">Pagar ahora</t>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@class='alert alert-warning']" position="replace">
        </xpath>
    </template>

    <template id="custom_confirmation" inherit_id="website_sale.confirmation">
        <xpath expr="//t[@t-call='website_sale.payment_confirmation_status']"
               position="replace">
            <t t-if="request.website.id == 1">
            </t>
            <t t-else="">
                <t t-call="website_sale.payment_confirmation_status"/>
            </t>
        </xpath>
    </template>

    <template id="remove_payment_info_from_confirmation" inherit_id="website_sale.confirmation"
              name="Remove Payment Info From Confirmation">
       <xpath expr="//h3" position="replace"></xpath>
        <xpath expr="//table[@class='table']" position="replace"/>
       <xpath expr="//div[@class='container oe_website_sale py-2']" position="attributes">
    <attribute name="class">
        container oe_website_sale py-2 mt-4
    </attribute>
</xpath>


    </template>

</odoo>
