<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_button_text" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="replace">
            <div id="payment_method" class="mt-3">
                <h3 class="mb24">Pagar con</h3>
                <div class="o_not_editable">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="payment_option_name">
                                    <b t-field="user_id.partner_id.property_payment_term_id.name"/>
                                </span>
                                <form action="/shop/payment/validate" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-check"/> Confirmar Pedido
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@class='alert alert-warning']" position="replace">
        </xpath>
    </template>
</odoo>
